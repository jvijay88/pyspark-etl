# Environment variables referenced by config/*.json as ${env:NAME}.
# Copy to secrets.env (git-ignored), fill in, then:  set -a; . config/secrets.env; set +a
# In production prefer ${aws-sm:<secret-id>#<key>} or ${file:/run/secrets/<name>}.

# config/extract.json and config/config.json -> mysql_config
MYSQL_USER=root
MYSQL_PASSWORD=

# config/config.json -> postgres_config
PG_USER=postgres
PG_PASSWORD=

# config/config.json -> snowflake_config
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
