{
    "transformations": [
        {
            "transformation": "calculate_tenure",
            "start_date_column": "hire_date",
            "target_column": "tenure_years"
        },
        {
            "transformation": "change_date_format",
            "source_column": "hire_date",
            "target_format": "dd-MM-yyyy"
        },
        {
            "transformation": "split",
            "source_column": "birth_date",
            "target_columns": [
                "birth_year",
                "birth_month",
                "birth_day"
            ],
            "separator": "-"
        },
        {
            "transformation": "normalize_strings",
            "source_columns": [
                "first_name",
                "last_name"
            ],
            "case_type": "upper"
        },
        {
            "transformation": "concatenate_columns",
            "source_columns": [
                "first_name",
                "last_name"
            ],
            "target_column": "Full_name"
        },
        {
            "transformation": "fill_missing_values",
            "mapping_dict": {
                "Full_name": "UNKNOWN"
            }
        },
        {
            "transformation": "drop_column",
            "source_columns": [
                "birth_date",
                "first_name",
                "last_name"
            ]
        },
        {
            "transformation": "filter_rows",
            "condition_expr": "tenure_years >= 0"
        },
        {
            "transformation": "join_tables",
            "source_tables": [
                "employees",
                "dept_emp"
            ],
            "source_column": "emp_no",
            "join_type": "inner"
        }
    ]
}